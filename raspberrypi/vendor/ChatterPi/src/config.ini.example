# ChatterPi settings (audio, triggers, controller thresholds).
# Copy to config.ini on the Pi:
#
#   cp config.ini.example config.ini
#
# Jaw/mouth angles, travel, and GPIO pin are NOT configured here — they come
# from raspberrypi/servo_limits.cfg (Mouth_* keys). Edit that file or use
# servo_test.py → Debug Servo Limits → Mouth.

[SERVO]
; PWM pulse widths in microseconds (hardware timing, rarely changed)
servo_min = 500
servo_max = 2500

[CONTROLLER]
style = 1
threshold = 2000
level1 = 1500
level2 = 2500
level3 = 3500
filtered_level1 = 1000
filtered_level2 = 2500
filtered_level3 = 4000

[AUDIO]
buffer_size = 4096
source = FILES
output_channels = BOTH
mic_time = 15
ambient = ON

[PROP]
prop_trigger = TIMER
delay = 5
jaw_enabled = ON
